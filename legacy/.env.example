# 复制为 .env 并填写。digest 容器和 push 脚本都读这个文件。

# FreshRSS API ───────────────────────────────
# digest 在容器内运行 → 用服务名 http://freshrss
# push.py 若从宿主机跑 → 改成 http://localhost:8080
FRESHRSS_URL=http://freshrss
FRESHRSS_USER=你的FreshRSS用户名
FRESHRSS_API_PASSWORD=你在FreshRSS里设置的API密码

# 每日日报 ───────────────────────────────────
DIGEST_LOOKBACK_HOURS=24
DIGEST_MAX_ITEMS=60

# 关键词过滤（逗号分隔，统一作用在聚合结果上）──
# include 命中任一才保留；exclude 命中任一就丢弃。都留空表示不过滤。
KEYWORDS_INCLUDE=
KEYWORDS_EXCLUDE=招聘,广告,预告,直播回顾

# AI 摘要（可选，留空则只列标题+链接）─────────
# Anthropic：  AI_API_URL=https://api.anthropic.com/v1/messages   AI_MODEL=claude-3-5-haiku-latest
# 豆包/DeepSeek 等 OpenAI 兼容： AI_API_URL=.../chat/completions    AI_MODEL=你的模型ID
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# 仅 push.py（Telegram/企业微信）用，纯 RSS 阅读可不填 ──
PUSH_MAX_ITEMS=20
TG_BOT_TOKEN=
TG_CHAT_ID=
WECOM_WEBHOOK=
